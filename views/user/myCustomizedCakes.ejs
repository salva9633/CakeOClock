<%- include("../../views/partials/user/header") %>

<%- include("../../views/partials/user/navbar") %>


<style>

.my-custom-page {
  min-height: 80vh;
  background: #fdf8f5;
  padding: 70px 30px;
}

.my-custom-container {
  max-width: 1100px;
  margin: auto;
}

.my-custom-title {
  text-align: center;
  color: #5c3a3a;
  margin-bottom: 10px;
}

.my-custom-subtitle {
  text-align: center;
  color: #a85f6e;
  margin-bottom: 40px;
}


.custom-request-card {

  background: white;

  border-radius: 20px;

  padding: 25px;

  margin-bottom: 25px;

  box-shadow:
    0 10px 35px
    rgba(168,95,110,.10);

  display: grid;

  grid-template-columns:
    180px 1fr;

  gap: 25px;

}


.custom-request-image {

  width: 180px;

  height: 180px;

  border-radius: 15px;

  overflow: hidden;

  background: #fbe4ec;

}


.custom-request-image img {

  width: 100%;

  height: 100%;

  object-fit: cover;

}


.no-image {

  width: 100%;

  height: 100%;

  display: flex;

  justify-content: center;

  align-items: center;

  color: #a85f6e;

}


.custom-request-content h3 {

  color: #8b4a5a;

  margin-bottom: 15px;

}


.custom-info {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 10px;

  margin-bottom: 15px;

}


.custom-info p {

  margin: 0;

  color: #8a6060;

}


.status {

  display: inline-block;

  padding: 6px 14px;

  border-radius: 30px;

  background: #fbe4ec;

  color: #8b4a5a;

  font-size: 13px;

  font-weight: 700;

}


.price {

  font-size: 20px;

  font-weight: 700;

  color: #a85f6e;

}


.custom-description {

  background: #fdf0f3;

  padding: 12px;

  border-radius: 10px;

  margin-top: 15px;

}


.empty-custom {

  background: white;

  text-align: center;

  padding: 70px 20px;

  border-radius: 20px;

}


.empty-custom h2 {

  color: #8b4a5a;

}


.customize-button {

  display: inline-block;

  margin-top: 20px;

  padding: 14px 25px;

  background: #a85f6e;

  color: white;

  border-radius: 30px;

  text-decoration: none;

  font-weight: 700;

}


@media(max-width:700px) {

  .custom-request-card {

    grid-template-columns: 1fr;

  }

  .custom-request-image {

    width: 100%;

    height: 230px;

  }

  .custom-info {

    grid-template-columns: 1fr;

  }

}
.quoted-price {
  font-size: 20px;
  font-weight: 700;
  color: #a85f6e;
  margin-bottom: 15px;
}

.waiting-price {
  font-size: 20px;
  font-weight: 700;
  color: #a85f6e;
}

.custom-checkout-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  padding: 12px 22px;

  background: linear-gradient(
    135deg,
    #a85f6e,
    #8b4a5a
  );

  color: white;

  border-radius: 30px;

  text-decoration: none;

  font-size: 14px;

  font-weight: 700;

  transition: .2s ease;
}

.custom-checkout-btn:hover {
  color: white;
  transform: translateY(-2px);

  box-shadow:
    0 8px 20px
    rgba(168,95,110,.25);
}

</style>


<div class="my-custom-page">

  <div class="my-custom-container">


    <h1 class="my-custom-title">

      My Customized Cakes

    </h1>


    <p class="my-custom-subtitle">

      Track your customized cake requests

    </p>


       <% if (
      customizedCakes &&
      customizedCakes.length > 0
    ) { %>

      <% customizedCakes.forEach(
        customizedCake => {
      %>


        <div class="custom-request-card">


          <div class="custom-request-image">

            <% if (
              customizedCake.referenceImage
            ) { %>

                            <img
                src="<%= customizedCake.referenceImage %>"
                alt="Cake reference"
              >


            <% } else { %>

              <div class="no-image">
                🎂 No Image
              </div>

            <% } %>

          </div>


          <div class="custom-request-content">


            <h3>

                         <%= customizedCake.cakeType %>
              Cake
            </h3>


            <div class="custom-info">

              <p>
                <strong>Weight:</strong>
                <%= customizedCake.weight %>
                          </p>


              <p>
                <strong>Required Date:</strong>

                <%= new Date(
                  customizedCake.neededDate
                ).toLocaleDateString() %>

              </p>


              <p>
                <strong>Time:</strong>

                <%= customizedCake.neededTime ||
                   "Not specified" %>
              </p>


              <p>

                <strong>Status:</strong>

                <span class="status">
                  <%= customizedCake.status %>
                </span>

              </p>

            </div>


            <div class="price">

<% if (customizedCake.quotedPrice && customizedCake.quotedPrice > 0) { %>

    <div class="quoted-price">
        Quoted Price:
        ₹<%= customizedCake.quotedPrice.toLocaleString("en-IN") %>
    </div>

    <% if (customizedCake.status === "quoted") { %>

        <a href="/customized-cake/cart/<%= customizedCake._id %>"
        class="custom-checkout-btn"
    >
        <i class="fa-solid fa-credit-card"></i>
        Add to Cart
        <i class="fa-solid fa-arrow-right"></i>
    </a>

<% } %>

<% } else { %>

    <div class="waiting-price">
        Price: Waiting for quotation
    </div>

<% } %>
</div>


            <div class="custom-description">

              <strong>
                Your Requirements:
              </strong>

                          <p>
                <%= customizedCake.description %>
              </p>
            </div>


            <% if (customizedCake.adminNote) { %>

              <div class="custom-description">

                <strong>
                  Message from Cake O'Clock:
                </strong>

                <p>
                  <%= customizedCake.adminNote %>
                </p>

              </div>

            <% } %>


          </div>

        </div>


      <% }) %>


    <% } else { %>


      <div class="empty-custom">

        <div style="font-size:60px;">
          🎂
        </div>

        <h2>
          No Customized Cakes Yet
        </h2>

        <p>
          Create your dream cake today.
        </p>


        <a
          href="/customized-cake"
          class="customize-button"
        >
          Customize Your Cake
        </a>

      </div>


    <% } %>


  </div>

</div>


<%- include("../../views/partials/user/footer") %>