<div class="customized-page">

  <div class="customized-container">

    <h1>Bake Your Own Cake!</h1>

    <p>
      Create a cake specially designed for your
      celebration.
    </p>


    <% if (error) { %>

      <div class="error-message">
        <%= error %>
      </div>

    <% } %>


    <form
      action="/customizedCake"
      method="POST"
      enctype="multipart/form-data"
    >


      <!-- CUSTOMER DETAILS -->

      <h2>Customer Details</h2>

      <div class="form-row">

        <div class="form-group">

          <label>Name *</label>

          <input
            type="text"
            name="name"
            value="<%= user?.name || '' %>"
            required
          >

        </div>


        <div class="form-group">

          <label>Email *</label>

          <input
            type="email"
            name="email"
            value="<%= user?.email || '' %>"
            required
          >

        </div>

      </div>


      <div class="form-row">

        <div class="form-group">

          <label>Phone *</label>

          <input
            type="tel"
            name="phone"
            value="<%= user?.phone || '' %>"
            required
          >

        </div>


        <div class="form-group">

          <label>Address *</label>

          <input
            type="text"
            name="address"
            required
          >

        </div>

      </div>


      <!-- CAKE DETAILS -->

      <h2>Cake Details</h2>


      <div class="form-row">

        <div class="form-group">

          <label>Cake Type *</label>

          <select
            name="cakeType"
            required
          >

            <option value="">
              Select Cake Type
            </option>

            <option value="Chocolate">
              Chocolate
            </option>

            <option value="Vanilla">
              Vanilla
            </option>

            <option value="Red Velvet">
              Red Velvet
            </option>

            <option value="Butterscotch">
              Butterscotch
            </option>

            <option value="Black Forest">
              Black Forest
            </option>

            <option value="Other">
              Other
            </option>

          </select>

        </div>


        <div class="form-group">

          <label>Weight *</label>

          <select
            name="weight"
            required
          >

            <option value="">
              Select Weight
            </option>

            <option value="500g">500g</option>
            <option value="1kg">1 KG</option>
            <option value="1.5kg">1.5 KG</option>
            <option value="2kg">2 KG</option>
            <option value="3kg">3 KG</option>
            <option value="4kg">4 KG</option>
            <option value="5kg">5 KG</option>

          </select>

        </div>

      </div>


      <!-- DESCRIPTION -->

      <div class="form-group">

        <label>
          Describe Your Cake *
        </label>

        <textarea
          name="description"
          rows="5"
          placeholder="Describe your cake design..."
          required
        ></textarea>

      </div>


      <!-- MESSAGE -->

      <div class="form-group">

        <label>
          Message on Cake
        </label>

        <input
          type="text"
          name="cakeMessage"
          placeholder="Happy Birthday Mom"
        >

      </div>


      <!-- IMAGE -->

      <div class="form-group">

        <label>
          Reference Image
        </label>

        <input
          type="file"
          name="referenceImage"
          accept="image/*"
        >

        <small>
          JPG, PNG, WEBP — Maximum 5MB
        </small>

      </div>


      <!-- DATE -->

      <div class="form-row">

        <div class="form-group">

          <label>
            Needed Date *
          </label>

          <input
            type="date"
            name="neededDate"
            id="neededDate"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Needed Time
          </label>

          <input
            type="time"
            name="neededTime"
          >

        </div>

      </div>


      <!-- ADDITIONAL REQUIREMENTS -->

      <div class="form-group">

        <label>
          Additional Requirements
        </label>

        <textarea
          name="additionalRequirements"
          rows="4"
          placeholder="Theme, colour, toppings, decoration..."
        ></textarea>

      </div>


      <button
        type="submit"
      >
        Submit Custom Cake Request
      </button>

    </form>

  </div>

</div>


<script>

const dateInput =
  document.getElementById("neededDate");

const today =
  new Date().toISOString().split("T")[0];

dateInput.min = today;

</script>