<!-- Navbar -->

<style>
.search-row-wrap { width: 400px; max-width: 100%; }
.search-form-wrap { flex: 1 1 auto; }

/* Hamburger toggle — hidden on desktop */
.mobile-menu-toggle {
  display: none;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  background: rgba(232,160,160,0.18);
  border: 1.5px solid rgba(139,58,82,0.2);
  border-radius: 50%;
  color: #8B3A52;
  font-size: 1rem;
  cursor: pointer;
  padding: 0;
}
.mobile-menu-toggle:focus { outline: none; box-shadow: none; }

/* ══════════════ NEW: mobile profile avatar (hidden on desktop) ══════════════ */
.user-avatar-mobile {
  display: none;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(232,160,160,0.25);
  color: #8B3A52;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: .82rem;
  overflow: hidden;
  flex-shrink: 0;
}
.user-avatar-mobile img { width: 100%; height: 100%; object-fit: cover; }

@media (max-width: 991.98px) {
  nav .container-fluid { flex-wrap: wrap; row-gap: 10px; padding-left: 24px; padding-right: 24px; }

  /* Shrink logo so logo + icons fit on one row down to 320px */
  .navbar-brand img { height: 48px; }

  .order-lg-2 { gap: 10px !important; }
  .order-lg-2 .header-icon i.fa-heart { font-size: .95rem !important; }
  .order-lg-2 .header-icon svg { width: 21px !important; height: 21px !important; }

  /* Swap name+chevron for a compact circular avatar on mobile */
  .user-name-desktop,
  .user-caret-desktop { display: none !important; }
  .user-avatar-mobile { display: inline-flex !important; }

  /* Row 2: search bar + hamburger, side by side, full width */
  .search-row-wrap {
    order: 3;
    width: 100%;
    max-width: 100%;
    margin: 4px 0 0 !important;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mobile-menu-toggle { display: inline-flex; }
}

@media (max-width: 575.98px) {
  nav .container-fluid { padding-left: 16px; padding-right: 16px; }
  .navbar-brand img { height: 40px; }
  .search-form-wrap input.form-control { font-size: .85rem; padding-right: 70px; }
  .order-lg-2 { gap: 8px !important; }
}

.secondary-nav-wrap { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 0; }
.secondary-nav-wrap a { margin: 4px 12px !important; }

/* On mobile the secondary nav becomes a dropdown panel toggled by the hamburger */
@media (max-width: 991.98px) {
  .secondary-nav-wrap {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #fff;
    border-top: 1px solid rgba(139,58,82,0.12);
    padding: 14px 16px;
  }
  .secondary-nav-wrap.show {
    display: flex;
  }
  .secondary-nav-wrap a {
    margin: 8px 0 !important;
    width: 100%;
  }
}

@media (max-width: 480px) {
  .secondary-nav-wrap a { margin: 4px 8px !important; font-size: .75rem !important; }
  .secondary-nav-wrap.show a { margin: 8px 0 !important; }
}
</style>

